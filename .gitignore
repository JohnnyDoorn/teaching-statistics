.Rproj.user
.Rhistory
.RData
.Ruserdata

.DS_Store
*_cache/

# Never commit exam materials — they must not reach students via the public repo.
# Matches any directory named "Exam" anywhere in the tree (current and future course years).
Exam/

# Personal revealjs lecture decks — rendered locally for presenting, not for students.
# The continuous-page .html is what gets linked from the overview pages.
*_slides.html

.quarto/

# Private working notes on the lecture decks (review notes, things to improve).
# The leading underscore keeps Quarto from rendering them; this keeps git from
# publishing them. The repo is public, so these must stay local.
_lecture-notes*.md

# Lecture recordings/transcripts: large, and not for the public repo.
transcripts/

# Course textbooks, whatever the format. Copyrighted, and this repo is public
# via GitHub Pages, so publishing them would be straightforward infringement.
# They are also 342 MB, which alone would push the site past the 1 GB Pages
# limit. Nothing here is tracked or referenced by any page.
statbooks/

# Agent instructions for this repo. Local working notes, not course material,
# and this repo is public — keep it out of git.
/CLAUDE.md
